// 旧バックアップ用：PBKDF2 + AES-GCM（あなたの旧コードを再利用）
function base64ToBytes(base64) {
  const binary = atob(base64);
  const len = binary.length;
  const bytes = new Uint8Array(len);
  for (let i = 0; i < len; i++) bytes[i] = binary.charCodeAt(i);
  return bytes;
}

async function deriveKeyFromPassword(password, saltBytes) {
  const enc = new TextEncoder();
  const pwKey = await crypto.subtle.importKey(
    "raw",
    enc.encode(password),
    "PBKDF2",
    false,
    ["deriveKey"]
  );

  return crypto.subtle.deriveKey(
    {
      name: "PBKDF2",
      salt: saltBytes,
      iterations: 100000,
      hash: "SHA-256"
    },
    pwKey,
    { name: "AES-GCM", length: 256 },
    false,
    ["encrypt", "decrypt"]
  );
}

async function decrypt(base64) {
  const bytes = base64ToBytes(base64);
  const salt = bytes.slice(0, 16);
  const iv = bytes.slice(16, 28);
  const cipher = bytes.slice(28);

  const key = await deriveKeyFromPassword(localStorage.getItem("aesKey"), salt);

  const plain = await crypto.subtle.decrypt(
    { name: "AES-GCM", iv },
    key,
    cipher
  );

  return new TextDecoder().decode(plain);
}


async function decryptWithPassword(base64, password) {
  const combined = base64ToBytes(base64);
  const salt = combined.slice(0, 16);
  const iv   = combined.slice(16, 28);
  const cipher = combined.slice(28);

  const key = await deriveKeyFromPassword(password, salt);

  const plain = await crypto.subtle.decrypt(
    { name: "AES-GCM", iv },
    key,
    cipher
  );

  return new TextDecoder().decode(plain);
}

async function verifyPassword(encryptedPassword, inputPassword) {
  try {
    const decrypted = await decryptWithPassword(encryptedPassword, inputPassword);
    return decrypted === inputPassword;
  } catch {
    return false;
  }
}

async function convertThisBackupToV3(saveText, password) {
  // ▼ JSON パース（p/k/d）
  const obj = JSON.parse(saveText);

  // ▼ パスワード照合
  const ok = await verifyPassword(obj.p, password);
  if (!ok) throw new Error("パスワードが違います");

  // ▼ aesKey 復元
  const aesKeyBase64 = await decryptWithPassword(obj.k, password);

  // ▼ decrypt() が使う aesKey をセット（旧方式）
  localStorage.setItem("aesKey", aesKeyBase64);

  // ▼ データ本体復号（旧 records[]）
  const json = await decrypt(obj.d);
  let records = JSON.parse(json);

  // ▼ 新方式へ変換（12レースごと）
  const final = [];
  let setId = 1;

  for (let i = 0; i < records.length; i += 12) {
    const set = records.slice(i, i + 12);
    if (set.length < 12) break;

    const totalScore12 = set.reduce((s, r) => s + r.score, 0);
    const setTimestamp = set[0].timestamp;

    set.forEach(r => {
      // ★ 新方式フィールドを付与
      r.totalScore12 = totalScore12;
      r.setId = setId;
      r.setTimestamp = setTimestamp;

      final.push(r);
    });

    setId++;
  }

  // ▼ DB（records ストア）に保存
  for (const r of final) {
    await addRecord(r);   // ★ 新方式レコードを旧ストア名 records に保存
  }

  // ▼ v3 バックアップ生成（必要なら）
  const body = JSON.stringify(final);
  const hash = await digestMessage(body);
  const base64 = btoa(body);

  return `MKADP_BACKUP_v3|${hash}|${base64}`;
}


