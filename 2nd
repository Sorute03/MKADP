    <label>復元パスワード：</label>
    <input id="restorePassword" type="password" placeholder="パスワードを入力" style="width:200px;">
    <input id="restoreFileInput" type="file" accept=".txt">
    <button id="restoreBackupBtn">復元する</button>
  </div>
</div>

<div style="margin-top:20px; padding:15px; border:1px solid #ccc; border-radius:8px;">
