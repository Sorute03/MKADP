function updateStatsView() {
  try {
    const records = getStatsFilteredRecords();

    const count = records.length;
    const avgRank = count ? (records.reduce((a,b)=>a+b.rank,0) / count) : 0;
    const avgScore = count ? (records.reduce((a,b)=>a+b.score,0) / count) : 0;
    const winRate = count ? (records.filter(r => r.rank <= 3).length / count) : 0;

    // ▼ basicStats 要素の存在確認
