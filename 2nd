function parsePlainTextRecords(text) {
  const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l);
  if (lines.length <= 1) throw new Error("テキストに有効なデータがありません");

  // 1行目で区切り文字を判定（タブ or カンマ）
  const delimiter = lines[0].includes("\t") ? "\t" : ",";
  const body = lines.slice(1);

  const raw = [];
  const now = Date.now();

  for (const line of body) {
    const cols = line.split(delimiter).map(c => c.trim());
    if (cols.length < 3) continue;

    const course = cols[0];
    const rank = Number(cols[1]);
    const score = Number(cols[2]);

    // ▼ season 正規化
    let season = "seasonN";
    if (cols[4]) {
      const num = cols[4].replace(/[^0-9]/g, "");
      if (num) season = "S" + num;
    }

    // ▼ tier 正規化
    let tier = "tierN";
    if (cols[5]) tier = cols[5].toUpperCase();

    if (!course || !rank || rank < 1 || rank > 24) continue;

    raw.push({
      course,
      rank,
      score,
      season,
      tier,
      mode: "lounge",
      timestamp: now - raw.length * 1000
    });
  }

  if (!raw.length) throw new Error("有効なレコードがありません");

  // ▼ 12レースごとに totalScore12 を付与
  const final = [];
  let setId = 1;

  for (let i = 0; i < raw.length; i += 12) {
    const set = raw.slice(i, i + 12);
    if (set.length < 12) break;

    const totalScore12 = set.reduce((s, r) => s + r.score, 0);
    const setTimestamp = set[0].timestamp;

    set.forEach(r => {
      r.totalScore12 = totalScore12;
      r.setId = setId;
      r.setTimestamp = setTimestamp;
      final.push(r);
    });

    setId++;
  }

  return final;
}

async function exportFullBackup() {
  // ▼ localStorage の全データ
  const ls = {};
  for (let i = 0; i < localStorage.length; i++) {
    const key = localStorage.key(i);
    ls[key] = localStorage.getItem(key);
  }

  // ▼ IndexedDB(records) の全データ
  const db = await openDB();
  const tx = db.transaction(["records"], "readonly");
  const store = tx.objectStore("records");
  const records = await store.getAll();

  // ▼ 全部まとめる
  const backup = {
    localStorage: ls,
    records: records
  };

  return JSON.stringify(backup);
}

async function importFullBackup(jsonText) {
  const backup = JSON.parse(jsonText);

  // ▼ localStorage を復元
  for (const [key, value] of Object.entries(backup.localStorage)) {
    localStorage.setItem(key, value);
  }

  // ▼ IndexedDB(records) を復元
  const db = await openDB();

  // 既存データを取得（重複チェック用）
  const existingTx = db.transaction(["records"], "readonly");
  const existingStore = existingTx.objectStore("records");
  const existingRecords = await existingStore.getAll();
  await new Promise(res => existingTx.oncomplete = res);

  // 既存の timestamp をセット化（高速重複チェック）
  const existingTimestamps = new Set(existingRecords.map(r => r.timestamp));

  // ▼ 新しいデータを入れる
  const tx = db.transaction(["records"], "readwrite");
  const store = tx.objectStore("records");

  for (const r of backup.records) {

    // ★ 重複チェック（timestamp）
    if (existingTimestamps.has(r.timestamp)) {
      console.log("重複スキップ:", r);
      continue;
    }

    // ★ 新規レコードとして追加
    store.put(r);

    // 重複チェック用セットに追加
    existingTimestamps.add(r.timestamp);
  }

  await new Promise(res => tx.oncomplete = res);
}

