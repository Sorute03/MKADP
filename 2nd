function filterByFormat(history, format) {
  if (format === "ALL") return history;
  return history.filter(h => h.player_count == Number(format));
}

function filterBySeason(history, season) {
  if (season === "ALL") return history;
  return history.filter(h => h.season == season);
}

function filterLastN(history, lastN) {
  if (!lastN) return history;
  return history.slice(-lastN * 12);
}

function filterFirstN(history, firstN) {
  if (!firstN) return history;
  return history.slice(0, firstN * 12);
}

function filterRace(history, tlast, tfirst) {
  let filtered = [...history];
  if (tlast) filtered = filtered.slice(-tlast);
  if (tfirst) filtered = filtered.slice(0, tfirst);
  return filtered;
}

function filterTier(history, tier) {
  if (tier === "ALL") return history;
  return history.filter(h => h.tier === tier);
}

function applyAllFilters(history) {
  const season = document.getElementById("seasonSelect").value;
  const format = document.getElementById("formatSelect").value;
  const lastN = Number(document.getElementById("lastNInput").value);
  const firstN = Number(document.getElementById("firstNInput").value);
  const tlast = Number(document.getElementById("tlastInput").value);
  const tfirst = Number(document.getElementById("tfirstInput").value);
  const tier = document.getElementById("tierSelect").value;

  let filtered = [...history];

  filtered = filterBySeason(filtered, season);
  filtered = filterByFormat(filtered, format);
  filtered = filterLastN(filtered, lastN);
  filtered = filterFirstN(filtered, firstN);
  filtered = filterRace(filtered, tlast, tfirst);
  filtered = filterTier(filtered, tier);

  return filtered;
}
  
/* ============================================================
   Lounge Stats Viewer — 関数群 完全版
   （state 初期化 → 背景 → プレイヤー情報 → MMR グラフ → 画像生成）
   ============================================================ */

// ▼ state（必ず最初に定義する）
const state = {
  backgroundImage: null,
  bgBrightness: 1,
  bgContrast: 1,
  bgOpacity: 1,
  bgBlur: 0
};

/* ============================================================
   ▼ 汎用パネル描画
   ============================================================ */
function drawPanel(ctx, x, y, w, h) {
  ctx.fillStyle = "rgba(0,0,0,0.55)";
  ctx.fillRect(x, y, w, h);

  ctx.strokeStyle = "rgba(0,150,255,0.8)";
  ctx.lineWidth = 2;
  ctx.strokeRect(x, y, w, h);
}

/* ============================================================
   ▼ プレイヤー情報パネル
   ============================================================ */
async function drawPlayerInfo(ctx, details, stats) {
  const x = 40;
  const y = 40;
  const w = 420;
  const h = 420;

  drawPanel(ctx, x, y, w, h);

  // ▼ プレイヤー名
  ctx.fillStyle = "#fff";
  ctx.font = "32px sans-serif";
  ctx.fillText(details.name, x + 20, y + 50);

  // ▼ 国旗
  await drawFlag(ctx, details.country, x + 20, y + 70);

  ctx.font = "20px sans-serif";
  ctx.fillText(`MMR: ${details.mmr}`, x + 20, y + 130);
  ctx.fillText(`Peak MMR: ${details.peak_mmr}`, x + 20, y + 160);
  ctx.fillText(`Avg: ${stats.avgScore}`, x + 20, y + 190);
  ctx.fillText(`W-L: ${details.wins} - ${details.losses}`, x + 20, y + 220);
  ctx.fillText(`Events: ${stats.matches}`, x + 20, y + 250);
  ctx.fillText(`Rank: ${stats.rank}`, x + 20, y + 280);
}

/* ============================================================
   ▼ MMR グラフ
   ============================================================ */
function drawMMRGraph(ctx, history) {
  const x = 500;
  const y = 40;
  const w = 700;
  const h = 420;

  drawPanel(ctx, x, y, w, h);

  if (!history.length) return;

  const ratings = history.map(h => h.mmr);
  const minR = Math.min(...ratings);
  const maxR = Math.max(...ratings);

  ctx.strokeStyle = "#00aaff";
  ctx.lineWidth = 3;
  ctx.beginPath();

  history.forEach((h, i) => {
    const px = x + 40 + (i / (history.length - 1)) * (w - 80);
    const py = y + h - 40 - ((h.mmr - minR) / (maxR - minR)) * (h - 80);

    if (i === 0) ctx.moveTo(px, py);
    else ctx.lineTo(px, py);
  });

  ctx.stroke();

  ctx.fillStyle = "#fff";
  ctx.font = "20px sans-serif";
  ctx.fillText("MMR Progression", x + 20, y + 30);
}

