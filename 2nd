async function drawAdpCourseImage(ctx, w, h) {

  // ▼ 背景画像が選択されているか？
  if (state.backgroundImage) {
    const img = new Image();
    img.src = state.backgroundImage;

    try {
      await img.decode();  // 画像読み込み

      // ▼ 背景フィルタ適用
      ctx.filter = `
        brightness(${state.bgBrightness})
        contrast(${state.bgContrast})
        blur(${state.bgBlur}px)
      `;
      ctx.globalAlpha = state.bgOpacity;

      // ▼ 背景画像を描画
      ctx.drawImage(img, 0, 0, w, h);

    } catch (e) {
      console.warn("背景画像の読み込みに失敗 → 背景色にフォールバックします");
      drawFallbackColor(ctx, w, h);
    }

  } else {
    // ▼ 背景画像なし → 背景色だけ
    drawFallbackColor(ctx, w, h);
  }

  // ▼ フィルタ解除
  ctx.filter = "none";
  ctx.globalAlpha = 1;

  // ▼ 既存のパネル・テキスト描画
  await drawAdpCoursePanels(ctx);
  await drawAdpCourseTexts(ctx);
}

function drawFallbackColor(ctx, w, h) {
  ctx.filter = `
    brightness(${state.bgBrightness})
    contrast(${state.bgContrast})
    blur(${state.bgBlur}px)
  `;
  ctx.globalAlpha = state.bgOpacity;

  ctx.fillStyle = state.bgColor || "#000";
  ctx.fillRect(0, 0, w, h);
}

document.getElementById("bgImageInput").onchange = (e) => {
  const file = e.target.files[0];
  if (!file) {
    state.backgroundImage = null;
    return;
  }

  const reader = new FileReader();
  reader.onload = () => {
    state.backgroundImage = reader.result;  // Base64 URL
  };
  reader.readAsDataURL(file);
};


async function sendAdpCourseImageToDiscord() {
  const canvas = document.getElementById("adpCourseImage");
  const base64 = canvas.toDataURL("image/png").replace(/^data:image\/png;base64,/, "");

  const webhook = getSelectedWebhookUrl();
  if (!webhook) {
    alert("Webhook が選択されていません");
    return;
  }

  const boundary = "----mkcBoundary" + new Date().getTime();

  const payload =
    Utilities.newBlob(
      base64,
      "image/png",
      "adp_course_stats.png"
    );

  const data = Utilities.newBlob(
    "--" + boundary + "\r\n" +
    "Content-Disposition: form-data; name=\"file\"; filename=\"adp_course_stats.png\"\r\n" +
    "Content-Type: image/png\r\n\r\n"
  ).getBytes()
    .concat(payload.getBytes())
    .concat(Utilities.newBlob("\r\n--" + boundary + "--").getBytes());

  await fetch(webhook, {
    method: "POST",
    body: data,
    headers: {
      "Content-Type": "multipart/form-data; boundary=" + boundary
    }
  });

  alert("Discord に画像を送信しました！");
}


document.getElementById("sendAdpCourseImageBtn").onclick = async () => {
  if (!window.latestAdpCourseStats) {
    alert("まず『表示』を押して結果を生成してください");
