function filterAdpRecords(records, filters) {
  return records.filter(r => {

    // season
    if (filters.season && r.season !== filters.season) return false;

    // tier
    if (filters.tier && r.tier !== filters.tier) return false;

    // course（複数）
    if (filters.courses && filters.courses.length > 0) {
      if (!filters.courses.includes(r.course)) return false;
    }

    return true;
  });
}

function applyRecentFilter(records, N) {
  if (!N || N <= 0) return records;
  return records.slice(-N);
}


function aggregateCourseStats(records) {
  const map = {};

  records.forEach(r => {
    if (!map[r.course]) {
      map[r.course] = {
        count: 0,
        ranks: [],
        scores: []
      };
    }
    map[r.course].count++;
    map[r.course].ranks.push(r.rank);
    map[r.course].scores.push(r.score);
  });

  return Object.entries(map).map(([course, data]) => {
    const avgRank = data.ranks.reduce((a,b)=>a+b,0) / data.ranks.length;
    const avgScore = data.scores.reduce((a,b)=>a+b,0) / data.scores.length;

    const sortedRanks = [...data.ranks].sort((a,b)=>a-b);
    const medianRank = sortedRanks[Math.floor(sortedRanks.length/2)];

    const winRate = data.ranks.filter(r => r <= 3).length / data.ranks.length;

    return {
      course,
      count: data.count,
      avgRank: Number(avgRank.toFixed(2)),
      avgScore: Number(avgScore.toFixed(2)),
      medianRank,
      winRate: Number((winRate * 100).toFixed(1))
    };
  });
}

function applyAndOrFilter(records, filters, mode) {
  if (mode === "AND") {
    return records.filter(r => {
      if (filters.season && r.season !== filters.season) return false;
      if (filters.tier && r.tier !== filters.tier) return false;
      if (filters.courses && filters.courses.length > 0 && !filters.courses.includes(r.course)) return false;
      return true;
    });
  }

  if (mode === "OR") {
    return records.filter(r => {
      return (
        (filters.season && r.season === filters.season) ||
        (filters.tier && r.tier === filters.tier) ||
        (filters.courses && filters.courses.includes(r.course))
      );
    });
  }

  return records;
}


async function getFilteredAdpCourseStats(filters) {
  let records = await loadADPIndexedDBRecords();

  // AND / OR フィルター
  records = applyAndOrFilter(records, filters, filters.mode);

  // 直近 N 件
  records = applyRecentFilter(records, filters.recent);

  // 集計
  const stats = aggregateCourseStats(records);

  // 最大 5 コースに制限
  return stats.slice(0, 5);
}
  
