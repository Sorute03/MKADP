<script>

/* ===========================
   IndexedDB データ操作関数
=========================== */

async function openDB() {
  return new Promise((resolve, reject) => {
    const req = indexedDB.open("mogiDB", 1);

    req.onupgradeneeded = e => {
      const db = e.target.result;

      // ★ records ストアを必ず作る
      if (!db.objectStoreNames.contains("records")) {
        db.createObjectStore("records", { keyPath: "timestamp" });
      }
    };

    req.onsuccess = e => resolve(e.target.result);
    req.onerror = e => reject(e.target.error);
  });
}


async function addRecord(record) {
  const db = await openDB();
  const tx = db.transaction(["records"], "readwrite");
  const store = tx.objectStore("records");

  if (!record.timestamp) {
    record.timestamp = Date.now();
  }

  store.add(record);
  await new Promise(res => tx.oncomplete = res);
}


async function updateRecord(record) {
  const db = await openDB();
  const tx = db.transaction(["records"], "readwrite");
  tx.objectStore("records").put(record);
  await new Promise(res => tx.oncomplete = res);
}


async function deleteRaceRecord(timestamp) {
  const db = await openDB();
  const tx = db.transaction(["records"], "readwrite");
  tx.objectStore("records").delete(timestamp);
  await new Promise(res => tx.oncomplete = res);
}


async function deleteRecordFromDB(timestamp) {
  await deleteRecord(timestamp);
}

async function getAllRacesFromDB() {
  const db = await openDB();
  return new Promise((resolve, reject) => {
    const tx = db.transaction(["records"], "readonly");
    const store = tx.objectStore("records");
    const req = store.getAll();
    
    req.onsuccess = () => resolve(req.result || []);
    req.onerror = () => reject(req.error);
  });
}


async function clearAllRacesFromDB() {
  const db = await openDB();
  const tx = db.transaction(["records"], "readwrite");
  tx.objectStore("records").clear();
  await new Promise(res => tx.oncomplete = res);
}


/* ===========================
   重複チェック関数
=========================== */

function isDuplicate(record1, record2) {
  // ▼ 基本プロパティの比較
  const basicMatch = (
    record1.course === record2.course &&
    record1.rank === record2.rank &&
    record1.score === record2.score &&
    record1.season === record2.season &&
    record1.tier === record2.tier &&
    record1.mode === record2.mode
  );
  
  if (!basicMatch) return false;
  
  // ▼ 両方ともタイムスタンプがある場合 → タイムスタンプも比較
  if (record1.timestamp && record2.timestamp) {
    return record1.timestamp === record2.timestamp;
  }
  
  // ▼ どちらかタイムスタンプがない場合 → タイムスタンプ以外で重複判定
  if (!record1.timestamp || !record2.timestamp) {
    return true;
  }
  
  return false;
}

function mergeRecordsWithDuplicateCheck(existingRecords, newRecords) {
  let addedCount = 0;
  let duplicateCount = 0;
  const mergedRecords = [...existingRecords];
  
  newRecords.forEach(newRec => {
    const hasDuplicate = mergedRecords.some(existing => isDuplicate(existing, newRec));
    
    if (hasDuplicate) {
      duplicateCount++;
    } else {
      mergedRecords.push(newRec);
      addedCount++;
    }
  });
  
  return { mergedRecords, addedCount, duplicateCount };
}

/* ===========================
   SHA256 ハッシュ関数
=========================== */

async function sha256(message) {
  const msgBuffer = new TextEncoder().encode(message);
  const hashBuffer = await crypto.subtle.digest("SHA-256", msgBuffer);
  const hashArray = Array.from(new Uint8Array(hashBuffer));
  return hashArray.map(b => b.toString(16).padStart(2, "0")).join("");
}

/* ===========================
   バックアップ・復元機能
=========================== */

// ▼ 1. パスワード付きバックアップ（保存）
document.getElementById("downloadBackupBtn").onclick = async () => {
  const password = document.getElementById("backupPassword").value.trim();
  if (!password) return alert("パスワードを入力してください");

  try {
    const records = await getAllRecordsFromDB();
    if (records.length === 0) return alert("保存するデータがありません");

    const backup = {
      version: "3.0",
      timestamp: Date.now(),
      count: records.length,
      records
    };

    const encoded = btoa(JSON.stringify(backup));
    const hash = await sha256(password);

    const content = `MKADP_BACKUP_v3|${hash}|${encoded}`;

    const blob = new Blob([content], { type: "text/plain" });
    const url = URL.createObjectURL(blob);

    const a = document.createElement("a");
    a.href = url;
    a.download = `mkadp_backup_${new Date().toISOString().split("T")[0]}.txt`;
    a.click();

    URL.revokeObjectURL(url);
    alert(`バックアップ保存完了（${records.length}件）`);
  } catch (err) {
    alert("バックアップ保存に失敗しました: " + err.message);
  }
};


document.getElementById("restoreBackupBtn").onclick = async () => {
  const password = document.getElementById("restorePassword").value.trim();
  const fileInput = document.getElementById("restoreFileInput");

  if (!password) return alert("パスワードを入力してください");
  if (!fileInput.files.length) return alert("ファイルを選択してください");

  try {
    const text = await fileInput.files[0].text();

    if (!text.startsWith("MKADP_BACKUP_v3|")) {
      return alert("無効なバックアップファイルです");
    }

    const parts = text.split("|");
    const storedHash = parts[1];
    const encoded = parts[2];

    const hash = await sha256(password);
    if (hash !== storedHash) return alert("パスワードが正しくありません");

    const backup = JSON.parse(atob(encoded));
    const incoming = backup.records;

    const existing = await getAllRecordsFromDB();
    const { mergedRecords, addedCount, duplicateCount } =
      mergeRecordsWithDuplicateCheck(existing, incoming);

    await clearAllRecordsFromDB();
    for (const r of mergedRecords) await addRecord(r);

    allRecords = [...mergedRecords];

    alert(
      `復元完了：\n新規追加: ${addedCount}件\n重複スキップ: ${duplicateCount}件\n合計: ${mergedRecords.length}件`
    );

    refreshAllAnalysisViews();
  } catch (err) {
    alert("バックアップ復元に失敗しました: " + err.message);
  }
};


// ▼ 3. 旧JSONファイル読み込み
document.getElementById("importOldJsonBtn").addEventListener("click", async () => {
  const fileInput = document.getElementById("oldJsonInput");
  if (!fileInput.files.length) return alert("ファイルを選択してください");

  try {
    const text = await fileInput.files[0].text();
    const data = JSON.parse(text);

    let records = Array.isArray(data)
      ? data
      : (data.allRecords && Array.isArray(data.allRecords))
        ? data.allRecords
        : null;

    if (!records || records.length === 0) {
      return alert("読み込むデータがありません");
    }

    // timestamp が無い場合は生成
    records = records.map((r, idx) => ({
      ...r,
      timestamp: r.timestamp || Date.now() - idx * 1000
    }));

    const existing = await getAllRecordsFromDB();
    const { mergedRecords, addedCount, duplicateCount } =
      mergeRecordsWithDuplicateCheck(existing, records);

    await clearAllRecordsFromDB();
