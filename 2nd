async function fetchAllStatsByName(name) {
  const playerId = await fetchPlayerIdByName(name);
  if (!playerId) throw new Error("プレイヤーが見つかりません");

  let allHistory = [];
  let peakMMR = 0;

  for (const s of seasons) {
    const hist = await fetchRateHistory(playerId, s);
    if (hist.length === 0) continue;

    allHistory = allHistory.concat(hist);

    const localPeak = Math.max(...hist.map(h => h.rating));
    if (localPeak > peakMMR) peakMMR = localPeak;
  }

  const ratings = allHistory.map(h => h.rating);
  const avgScore = ratings.length
    ? (ratings.reduce((a,b)=>a+b,0) / ratings.length).toFixed(2)
    : "-";

  return {
    playerId,
    seasons,
    history: allHistory,
    peakMMR,
    avgScore,
    matches: ratings.length
  };
}

