function updateGrowthView() {
  const records = getGrowthFilteredRecords();
  if (!records.length) {
    drawGrowthChart([], []);
    return;
  }

  const grouped = {};
  records.forEach(r => {
    if (!grouped[r.course]) grouped[r.course] = [];
    grouped[r.course].push(r.score);
  });

  const labels = Object.keys(grouped);
  const values = labels.map(c => {
    const arr = grouped[c];
