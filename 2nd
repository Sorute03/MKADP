   ▼ 国旗描画
   ============================================================ */
async function drawFlag(ctx, country, x, y) {
  if (!country) return;

  const flag = new Image();
  flag.src = `flags/${country}.png`;

  await flag.decode();

  ctx.drawImage(flag, x, y, 60, 40);
}

/* ============================================================
   ▼ 背景設定（明るさ・コントラスト・ぼかし・透過）
   ============================================================ */
function setBgImage(file) {
  const reader = new FileReader();
  reader.onload = () => state.backgroundImage = reader.result;
  reader.readAsDataURL(file);
}

function setBgBrightness(v) { state.bgBrightness = Number(v); }
function setBgContrast(v) { state.bgContrast = Number(v); }
function setBgOpacity(v) { state.bgOpacity = Number(v); }
function setBgBlur(v) { state.bgBlur = Number(v); }

/* ============================================================
   ▼ 背景描画
   ============================================================ */
async function drawBackground(ctx, w, h) {
  if (!state.backgroundImage) {
    ctx.fillStyle = "#000";
    ctx.fillRect(0, 0, w, h);
    return;
  }

  const bg = new Image();
  bg.src = state.backgroundImage;
  await bg.decode();

  ctx.filter = `
    brightness(${state.bgBrightness})
    contrast(${state.bgContrast})
    blur(${state.bgBlur}px)
  `;

  ctx.globalAlpha = state.bgOpacity;

  ctx.drawImage(bg, 0, 0, w, h);

  ctx.filter = "none";
  ctx.globalAlpha = 1;
}

