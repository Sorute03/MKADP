    alert("最大5コースまで選択できます");
  }
});
  
function getSelectedWebhookUrl() {
  return currentWebhookUrl; // あなたの既存変数に合わせて変更
}

function buildAdpCourseStatsMessage(stats) {
  let lines = [];
  lines.push("**ADP コース比較結果（最大5コース）**");

  stats.forEach(s => {
    lines.push(
      `\n【${s.course}】\n` +
      `走行数: ${s.count}\n` +
      `平均順位: ${s.avgRank}\n` +
      `中央値: ${s.medianRank}\n` +
      `勝率(3位以内): ${s.winRate}%\n` +
      `平均得点: ${s.avgScore}\n`
    );
  });

  return lines.join("\n");
}

async function sendAdpCourseStatsToDiscord(stats) {
  const webhook = getSelectedWebhookUrl();
  if (!webhook) {
    alert("Webhook が選択されていません");
    return;
  }

  const message = buildAdpCourseStatsMessage(stats);

  const payload = {
    content: message
  };

  await fetch(webhook, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  });

  alert("Discord に送信しました！");
}

