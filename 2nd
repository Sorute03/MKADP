function drawHeatmap(map) {
  const ctx = document.getElementById("chartHeatmap").getContext("2d");

  if (window.chartHeatmap && typeof window.chartHeatmap.destroy === "function") {
    window.chartHeatmap.destroy();
  }

  const courses = Object.keys(map);
  const values = courses.map(c => {
    const arr = map[c];
    let sum = 0, count = 0;
    arr.forEach((v,i)=>{ sum += v * (i+1); count += v; });
    return count ? sum / count : 12;
  });

  window.chartHeatmap = new Chart(ctx, {
    type: "bar",
    data: {
      labels: courses,
      datasets: [{
        label: "平均順位（低いほど良い）",
        data: values,
        backgroundColor: values.map(v => {
          const t = (12 - v) / 12;
          const g = Math.round(255 * t);
          const r = Math.round(255 * (1 - t));
          return `rgba(${r},${g},100,0.8)`;
        })
      }]
    },
    options: {
      indexAxis: "y",
      responsive: true,
      plugins: { legend: { display: false } },
      scales: { x: { beginAtZero: true, max: 12 } }
    }
  });
}



