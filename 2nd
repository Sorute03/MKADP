/* ▼ 保存処理（新構造対応・編集モード対応） */
saveRaceBtn.onclick = async () => {
  const mode = modalMode.value;
  const count = mode === "lounge" ? 12 : Number(modalRaceCount.value);

  const newRecords = [];
  const raceScores = [];

  // ▼ 入力されたレースを収集
  for (let i = 1; i <= count; i++) {
    const rank = Number(document.getElementById(`raceRank_${i}`).value);
    if (!rank) continue;

    const course = document.getElementById(`raceCourse_${i}`).value;
    const score = calcScore(rank);

    raceScores.push(score);

    newRecords.push({
      mode,
      season: mode === "lounge" ? modalSeason.value : null,
      tier: mode === "lounge" ? modalTier.value : null,
      course,
      rank,
      score,
      timestamp: editingTimestamp ?? Date.now()
    });
  }

  if (!newRecords.length) {
    alert("1レース以上入力してください");
    return;
  }

  /* ▼ ラウンジモードなら totalScore12 を付与 */
  if (mode === "lounge" && newRecords.length === 12) {
    const totalScore12 = raceScores.reduce((a, b) => a + b, 0);
    newRecords.forEach(r => (r.totalScore12 = totalScore12));
  }

  /* ▼ 編集モードなら古いレコードを削除（DB + メモリ） */
  if (editingTimestamp) {
    await deleteRecordFromDB(editingTimestamp);
    allRecords = allRecords.filter(r => r.timestamp !== editingTimestamp);
  }

  /* ▼ 新規レコードを DB に保存 */
  for (const r of newRecords) {
    await addRecord(r);
  }

  /* ▼ メモリ側 allRecords に反映 */
  allRecords.push(...newRecords);

  /* ▼ 送信キューに追加 */
  const queue = JSON.parse(localStorage.getItem("sendQueue") || "[]");
  queue.push(...newRecords);
  localStorage.setItem("sendQueue", JSON.stringify(queue));

  /* ▼ UI 再描画（新構造） */
  renderRaceHistory(getFilteredRecords());


  /* ▼ 後処理 */
  editingTimestamp = null;
  modal.classList.remove("show");
};


</script>


