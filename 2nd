async function fetchRateHistory(playerId, season, playerCount = 3000) {
  const url = season === 1
    ? `https://lounge.mkcentral.com/mkworld/PlayerDetails/${playerId}?season=1`
    : `https://lounge.mkcentral.com/mkworld/PlayerDetails/${playerId}?season=${season}&p=${playerCount}`;

  const res = await fetch(url, { headers: { "User-Agent": "Mozilla/5.0" } });
  const html = await res.text();

  let mmrMatches = [...html.matchAll(/class="rank-[^"]*"\s*>\s*([\d,]+)\s*</g)];
  if (mmrMatches.length === 0 && season === 1) {
    mmrMatches = [...html.matchAll(/class="rating"[^>]*>\s*([\d,]+)\s*</g)];
  }

  const mmrs = mmrMatches.map(m => Number(m[1].replace(/,/g, "")));

  return mmrs.map((mmr, i) => ({ rating:mmr, index:i, season }));
}

