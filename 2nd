<script>
function renderRaceHistory(records) {
  const box = document.getElementById("raceHistoryList");
  if (!box) return;

  // ▼ 共通フィルター済み records が渡される前提
  let list = records || [];

  // ▼ DB版：timestamp は必ず存在するのでシンプルに新しい順
  list = clone(list).sort((a, b) => b.timestamp - a.timestamp);

  if (!list.length) {
    box.innerHTML = "<p>レース履歴がありません。</p>";
    return;
  }

  box.innerHTML = "";

  list.forEach(r => {
    const div = document.createElement("div");
    div.className = "race-history-item";
    div.style = "padding:8px; border-bottom:1px solid #ddd;";

    const date = new Date(r.timestamp).toLocaleString();

    div.innerHTML = `
      <strong>${r.course}</strong>
      (${r.rank}位 / ${r.score}点 / ${r.mode})
      <span style="margin-left:10px; color:#555;">${date}</span>

      <button class="editBtn" data-ts="${r.timestamp}" style="margin-left:10px;">
        編集
      </button>

      <button class="deleteBtn" data-ts="${r.timestamp}" style="margin-left:10px;">
        削除
      </button>
    `;

    box.appendChild(div);
  });

  // ▼ 編集ボタン
  document.querySelectorAll(".editBtn").forEach(btn => {
    btn.onclick = () => openEditRecord(Number(btn.dataset.ts));
  });

  // ▼ 削除ボタン
  document.querySelectorAll(".deleteBtn").forEach(btn => {
    btn.onclick = () => deleteRecord(Number(btn.dataset.ts));
  });
}
</script>


<script>

let editingTimestamp = null;

async function openEditRecord(ts) {
  const r = allRecords.find(x => x.timestamp === ts);
  if (!r) {
    alert("データが見つかりません");
    return;
  }

  editingTimestamp = ts;

  modal.classList.add("show");

  modalMode.value = r.mode;
  updateModalMode();

  if (r.mode === "lounge") {
    modalTier.value = r.tier || "ALL";
    modalSeason.value = r.season || "ALL";
  }

  generateRaceInputs(1);

  document.getElementById("raceCourse_1").value = r.course;
  document.getElementById("raceRank_1").value = r.rank;
  document.getElementById("raceScore_1").value = r.score;

  saveRaceBtn.onclick = async () => {
    const course = document.getElementById("raceCourse_1").value;
    const rank   = Number(document.getElementById("raceRank_1").value);
    const score  = Number(document.getElementById("raceScore_1").value);

    if (!course || !rank) {
      alert("コースと順位は必須です");
      return;
    }

    // ▼ レコード更新
    r.course = course;
    r.rank   = rank;
    r.score  = score;
    r.mode   = modalMode.value;

    if (r.mode === "lounge") {
      r.tier   = modalTier.value;
      r.season = modalSeason.value;
    }

    // ▼ DB に保存
    await updateRecord(r);

    // ▼ メモリ側も更新
    const idx = allRecords.findIndex(x => x.timestamp === ts);
    if (idx >= 0) allRecords[idx] = r;

    // ▼ UI 更新
    const filtered = getGloballyFilteredRecords();
    refreshModeView();
    renderRaceHistory(filtered);

    modal.classList.remove("show");
    editingTimestamp = null;
  };
}


